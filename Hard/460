460. LFU Cache
import java.util.HashMap;
import java.util.LinkedHashSet;

class LFUCache {

    private int capacity;
    private int minFreq;

    private HashMap<Integer, Integer> values;
    private HashMap<Integer, Integer> frequencies;
    private HashMap<Integer, LinkedHashSet<Integer>> freqMap;

    public LFUCache(int capacity) {
        this.capacity = capacity;
        this.minFreq = 0;

        values = new HashMap<>();
        frequencies = new HashMap<>();
        freqMap = new HashMap<>();
    }

    public int get(int key) {
        if (!values.containsKey(key)) {
            return -1;
        }

        updateFrequency(key);
        return values.get(key);
    }

    public void put(int key, int value) {
        if (capacity == 0) {
            return;
        }

        if (values.containsKey(key)) {
            values.put(key, value);
            updateFrequency(key);
            return;
        }

        if (values.size() == capacity) {
            LinkedHashSet<Integer> keys = freqMap.get(minFreq);
            int lruKey = keys.iterator().next();

            keys.remove(lruKey);
            values.remove(lruKey);
            frequencies.remove(lruKey);
        }

        values.put(key, value);
        frequencies.put(key, 1);

        freqMap.computeIfAbsent(1, k -> new LinkedHashSet<>()).add(key);

        minFreq = 1;
    }

    private void updateFrequency(int key) {
        int freq = frequencies.get(key);

        LinkedHashSet<Integer> keys = freqMap.get(freq);
        keys.remove(key);

        if (keys.isEmpty()) {
            freqMap.remove(freq);

            if (minFreq == freq) {
                minFreq++;
            }
        }

        int newFreq = freq + 1;

        frequencies.put(key, newFreq);

        freqMap.computeIfAbsent(newFreq, k -> new LinkedHashSet<>()).add(key);
    }
}
